APP_NAME=origyuan-automation-service
APP_ENV=local
APP_PORT=3000

# Fingerprint browser placeholders. Do not commit real secrets.
FINGERPRINT_BROWSER_URL=http://127.0.0.1:50325
FINGERPRINT_BROWSER_TOKEN=changeme

# VPS SSH placeholders. Mock mode does not execute SSH commands.
VPS_SSH_HOST=127.0.0.1
VPS_SSH_PORT=22
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=~/.ssh/id_rsa

# OpenClaw control-plane placeholders. Do not commit real secrets.
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=changeme

# Northbound / southbound control-plane placeholders.
NEW_API_BASE_URL=
NEW_API_API_KEY=
NEW_API_TIMEOUT_MS=3000
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_TIMEOUT_MS=3000
LEGACY_PROXY_BASE_URL=
LEGACY_PROXY_API_KEY=
ROUTER9_BASE_URL=http://127.0.0.1:20128
ROUTER9_TIMEOUT_MS=2000

# Cloudflare edge placeholders.
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_API_HOSTNAME=
CLOUDFLARE_LEGACY_HOSTNAME=
CLOUDFLARE_ACCESS_AUDIENCE=

# Future automation/task placeholders.
TASK_MODE=hybrid
TASK_DEFAULT_TIMEOUT_MS=30000
QUEUE_MAX_RETRIES=3
LOG_DIR=logs
WEBHOOK_SECRET=
